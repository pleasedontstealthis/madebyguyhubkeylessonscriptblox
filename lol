local KEY = 173
local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function decode(data)
    data = data:gsub("%s+", "")
    local out = {}
    for i = 1, #data, 4 do
        local a = ALPHABET:find(data:sub(i, i), 1, true) or 1
        local b = ALPHABET:find(data:sub(i + 1, i + 1), 1, true) or 1
        local cchar = data:sub(i + 2, i + 2)
        local dchar = data:sub(i + 3, i + 3)
        local c = cchar == "=" and 0 or (ALPHABET:find(cchar, 1, true) or 1)
        local d = dchar == "=" and 0 or (ALPHABET:find(dchar, 1, true) or 1)
        local n1 = (a - 1) * 4 + math.floor((b - 1) / 16)
        local n2 = ((b - 1) % 16) * 16 + math.floor((c - 1) / 4)
        local n3 = ((c - 1) % 4) * 64 + (d - 1)
        out[#out + 1] = string.char(bit32.bxor(n1, KEY))
        if cchar ~= "=" then out[#out + 1] = string.char(bit32.bxor(n2, KEY)) end
        if dchar ~= "=" then out[#out + 1] = string.char(bit32.bxor(n3, KEY)) end
    end
    return table.concat(out)
end
